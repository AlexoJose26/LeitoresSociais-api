{
  "name": "leitoressociais-api",
  "version": "1.0.0",
  "description": "API de produção da rede social para leitores LeitoresSociais",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bunx tsc --noEmit",
    "check": "bunx tsc --noEmit",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:push": "bunx drizzle-kit push"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.3",
    "elysia": "^1.4.30",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  }
}
